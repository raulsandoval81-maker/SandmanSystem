diff --git a/public/assets/js/scoped-coach-athletes.js b/public/assets/js/scoped-coach-athletes.js
new file mode 100644
index 0000000..6a7d02e
--- /dev/null
+++ b/public/assets/js/scoped-coach-athletes.js
@@ -0,0 +1,73 @@
+import {
+  auth, db, collection, doc, getDoc, getDocs, limit, onSnapshot, query, where
+} from "./firebase-init.js";
+
+async function rosterQueries() {
+  const user = auth.currentUser;
+  if (!user || user.isAnonymous) throw new Error("Coach roster requires a staff sign-in.");
+  const staff = (await getDoc(doc(db, "staff", user.uid))).data();
+  if (auth.currentUser?.uid !== user.uid || staff?.status !== "active") {
+    throw new Error("Coach roster requires active staff access.");
+  }
+
+  const athletes = collection(db, "athletes");
+  if (["admin", "system_admin"].includes(staff.role)) return [athletes];
+  if (staff.role !== "coach") throw new Error("Coach roster requires Coach or Admin access.");
+
+  const locations = new Set([
+    ...(Array.isArray(staff.locationIds) ? staff.locationIds : []),
+    ...(Array.isArray(staff.locations) ? staff.locations : []),
+    staff.locationId
+  ].filter((id) => typeof id === "string" && id.length > 0));
+  return [
+    ...[...locations].map((id) => query(athletes, where("locationId", "==", id))),
+    query(athletes, where("coachUid", "==", user.uid)),
+    query(athletes, where("coachIds", "array-contains", user.uid))
+  ];
+}
+
+function rosterSnapshot(snapshots, { filter = () => true, max, compare } = {}) {
+  const byId = new Map();
+  for (const snapshot of snapshots) {
+    for (const item of snapshot.docs) byId.set(item.id, item);
+  }
+  let docs = [...byId.values()].filter(filter).sort(compare ?? ((a, b) =>
+    a.id < b.id ? -1 : a.id > b.id ? 1 : 0
+  ));
+  if (max !== undefined) docs = docs.slice(0, max);
+  return { docs, empty: docs.length === 0, size: docs.length, forEach: (callback) => docs.forEach(callback) };
+}
+
+export async function getScopedCoachAthletes(options = {}) {
+  const queries = await rosterQueries();
+  const snapshots = await Promise.all(queries.map((ref) =>
+    getDocs(options.max && !options.filter && !options.compare ? query(ref, limit(options.max)) : ref)
+  ));
+  return rosterSnapshot(snapshots, options);
+}
+
+export function subscribeScopedCoachAthletes(next, error, options) {
+  let active = true;
+  const unsubscribes = [];
+  const stop = () => {
+    active = false;
+    unsubscribes.forEach((unsubscribe) => unsubscribe());
+  };
+  const fail = (cause) => {
+    if (!active) return;
+    stop();
+    error?.(cause);
+  };
+  rosterQueries().then((queries) => {
+    if (!active) return;
+    const snapshots = new Map();
+    queries.forEach((ref, index) => {
+      unsubscribes.push(onSnapshot(ref, (snapshot) => {
+        if (!active) return;
+        snapshots.set(index, snapshot);
+        if (snapshots.size === queries.length) next(rosterSnapshot(snapshots.values(), options));
+      }, fail));
+    });
+  }).catch(fail);
+  return stop;
+}
