<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta
    name="viewport"
    content="width=device-width,initial-scale=1"
  />

  <title>Management Access | Sandman Combat™</title>

  <meta
    name="robots"
    content="noindex,nofollow"
  />

  <link
    rel="stylesheet"
    href="/assets/css/portal-auth.css"
  />
<style>
    .remember-row {
      display: flex !important;
      align-items: flex-start !important;
      gap: 10px !important;
      margin: 4px 0 16px !important;
      color: #374151 !important;
      cursor: pointer !important;
    }

    .remember-row input {
      width: 18px !important;
      height: 18px !important;
      min-height: 18px !important;
      margin: 2px 0 0 !important;
      padding: 0 !important;
      flex: 0 0 18px !important;
      accent-color: #d4af37 !important;
      box-shadow: none !important;
    }

    .remember-row span {
      display: block !important;
      line-height: 1.35 !important;
    }

    .remember-row strong {
      display: block !important;
      color: #111827 !important;
      font-size: 0.9rem !important;
      font-weight: 900 !important;
    }

    .remember-row small {
      display: block !important;
      margin-top: 3px !important;
      color: #6b7280 !important;
      font-size: 0.78rem !important;
      font-weight: 500 !important;
      line-height: 1.4 !important;
    }
</style>

  <link
    rel="stylesheet"
    href="/assets/css/first-time-access.css"
  >
  <link rel="stylesheet" href="/assets/css/password-toggle.css">

  <!-- SHARED SANDMAN AUTH UI -->
  <link
    rel="stylesheet"
    href="/assets/css/sandman-auth-unified.css"
  >

</head>

<body>
  <main class="card">

    <p class="kicker">
      Management Portal
    </p>

    <h1>
      Management Access
    </h1>

    <p class="sub">
      Sign in with an approved Location Manager,
      Program Manager, or System Admin account.
    </p>

    <label for="email">
      Email
    </label>

    <input
      id="email"
      type="email"
      inputmode="email"
      autocomplete="username"
      placeholder="manager@example.com"
    />

    <label for="password">
      Password
    </label>

    <input
      id="password"
      type="password"
      autocomplete="current-password"
      placeholder="Password"
    />

    <label class="remember-row" for="keepSignedIn">
      <input
        id="keepSignedIn"
        type="checkbox"
      />

      <span>
        <strong>Keep me signed in on this device</strong>

        <small>
          Leave unchecked on shared devices or when you regularly
          use more than one Sandman account.
        </small>
      </span>
    </label>



    <button
      id="loginBtn"
      type="button"
    >
      Sign In
    </button>

    <button
      id="resetBtn"
      class="link-btn"
      type="button"
    >
      Forgot Password?
    </button>
        <!-- FIRST-TIME ACCESS -->
        <div class="first-time-access">
          <span class="first-time-access__label">
            First time here?
          </span>

          <a
            class="first-time-access__link"
            href="/access/first-time/?role=management"
          >
            Set Up Management Access
          </a>
        </div>
        <!-- /FIRST-TIME ACCESS -->


    <div
      id="status"
      class="status"
      aria-live="polite"
    ></div>

    <a
      class="back-link"
      href="/login/"
    >
      ← Choose a different role
    </a>

  </main>

  <script type="module">
import {
  auth,
  db,
  doc,
  getDoc
} from "/assets/js/firebase-init.js";

    import {
      signInWithEmailAndPassword,
      sendPasswordResetEmail,
      onAuthStateChanged,
      signOut,
  browserLocalPersistence,
  browserSessionPersistence,
  setPersistence
} from "https://www.gstatic.com/firebasejs/10.13.1/firebase-auth.js";


const keepSignedIn =
  document.getElementById("keepSignedIn");

async function applyAuthPersistence() {
  await setPersistence(
    auth,
    keepSignedIn?.checked
      ? browserLocalPersistence
      : browserSessionPersistence
  );
}



    const emailEl =
      document.getElementById("email");

    const passwordEl =
      document.getElementById("password");

    const loginBtn =
      document.getElementById("loginBtn");

    const resetBtn =
      document.getElementById("resetBtn");

    const statusEl =
      document.getElementById("status");

    const params =
      new URLSearchParams(window.location.search);

    const requestedReturnUrl =
      params.get("returnUrl") ||
      params.get("next") ||
      "";

    let checkingAccess = false;

    function setStatus(
      message = "",
      isError = false
    ) {
      statusEl.textContent = message;

      statusEl.classList.toggle(
        "error",
        isError
      );
    }

    function setBusy(isBusy) {
      emailEl.disabled = isBusy;
      passwordEl.disabled = isBusy;
      loginBtn.disabled = isBusy;
      resetBtn.disabled = isBusy;
    }

function getSafeReturnUrl() {
  const isSafeManagementPath =
    requestedReturnUrl.startsWith(
      "/management/"
    );

  const isSafeProspectBuilderPath =
    requestedReturnUrl.startsWith(
      "/connect/admissions/calculator/"
    );

  if (
    !requestedReturnUrl.startsWith("//") &&
    (
      isSafeManagementPath ||
      isSafeProspectBuilderPath
    )
  ) {
    return requestedReturnUrl;
  }

  return "/management/hub/";
}

async function hasManagementAccess(user) {
  const staffRef = doc(
    db,
    "staff",
    user.uid
  );

  const staffSnapshot =
    await getDoc(staffRef);

  if (!staffSnapshot.exists()) {
    return false;
  }

  const staff =
    staffSnapshot.data();

  const role =
    String(staff.role || "")
      .trim()
      .toLowerCase();

  const status =
    String(staff.status || "")
      .trim()
      .toLowerCase();

  return (
    status === "active" &&
    [
      "admin",
      "management",
      "manager",
      "location_manager"
    ].includes(role)
  );
}

    async function finishLogin(user) {
      if (
        !user ||
        checkingAccess
      ) {
        return;
      }

      checkingAccess = true;
      setBusy(true);

      try {
        setStatus(
          "Checking Management access..."
        );

        const authorized =
          await hasManagementAccess(user);

        if (!authorized) {
          await signOut(auth);

          setStatus(
            "This account does not have Management access.",
            true
          );

          return;
        }

        setStatus(
          "Access approved. Opening Management..."
        );

        window.location.replace(
          getSafeReturnUrl()
        );
      } catch (error) {
        console.error(
          "[management-login] access check failed:",
          error
        );

        setStatus(
          "Unable to verify Management access.",
          true
        );
      } finally {
        checkingAccess = false;
        setBusy(false);
      }
    }

    loginBtn.addEventListener(
      "click",
      async () => {
        const email =
          emailEl.value
            .trim()
            .toLowerCase();

        const password =
          passwordEl.value;

        if (!email || !password) {
          setStatus(
            "Enter email and password.",
            true
          );

          return;
        }

        try {
          setBusy(true);
          setStatus("Signing in...");

          await applyAuthPersistence();

          const credential =
            await signInWithEmailAndPassword(
              auth,
              email,
              password
            );

          await finishLogin(
            credential.user
          );
        } catch (error) {
          console.error(
            "[management-login] sign-in failed:",
            error
          );

          setStatus(
            "Sign-in failed. Check your email and password.",
            true
          );

          setBusy(false);
        }
      }
    );

    passwordEl.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Enter") {
          loginBtn.click();
        }
      }
    );

    resetBtn.addEventListener(
      "click",
      async () => {
        const email =
          emailEl.value
            .trim()
            .toLowerCase();

        if (!email) {
          setStatus(
            "Enter your email first.",
            true
          );

          return;
        }

        try {
          setBusy(true);

          setStatus(
            "Sending password reset email..."
          );

          await sendPasswordResetEmail(
            auth,
            email
          );

          setStatus(
            "Password reset email sent."
          );
        } catch (error) {
          console.error(
            "[management-login] reset failed:",
            error
          );

          setStatus(
            "Unable to send password reset email.",
            true
          );
        } finally {
          setBusy(false);
        }
      }
    );

    onAuthStateChanged(
      auth,
      async (user) => {
        if (!user) {
          return;
        }

        emailEl.value =
          user.email || "";

        await finishLogin(user);
      }
    );
  </script>
  <script src="/assets/js/password-toggle.js" defer></script>
</body>
</html>
